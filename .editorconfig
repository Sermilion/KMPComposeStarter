root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 2
max_line_length = 100
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# ktlint reads its own settings from here too, so spotless needs no editorConfigOverride map that
# could drift away from what the IDE applies.
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_no-wildcard-imports = disabled
# ktlint 1.8 (spotless 8.x) added when-entry-bracing, which braces every branch of a `when` as soon
# as one branch needs braces. The starter keeps single-expression branches unbraced.
ktlint_standard_when-entry-bracing = disabled
# The Kotest suites document a regression per `test(...)` call with a KDoc block. The new kdoc rule
# rejects KDoc inside a lambda; the comments are worth more than the rule.
ktlint_standard_kdoc = disabled

[*.xml]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
