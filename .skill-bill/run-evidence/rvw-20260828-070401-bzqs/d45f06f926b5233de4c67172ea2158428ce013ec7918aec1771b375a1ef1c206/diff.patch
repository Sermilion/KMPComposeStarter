-    if (current == null) {
-      val component = userComponentFactory.create(userData)
-      _userComponent.value = component
-      _userComponentFlow.value = component
+  override fun createComponent(userData: UserData): UserDependencies {
+    while (true) {
+      val current = state.value
+      if (current != null && current.userData == userData) return current
+
+      val replacement = userComponentFactory.create(userData)
+      if (state.compareAndSet(current, replacement)) {
+        current?.let(::tearDown)
+        return replacement
+      }
+      // Lost the race: this component was never published, so closing it here cannot double-close.
+      tearDown(replacement)
     }
   }
 
   override fun destroyComponent() {
-    _userComponent.value = null
-    _userComponentFlow.value = null
+    state.getAndUpdate { null }?.let(::tearDown)
+  }
+
+  private fun tearDown(dependencies: UserDependencies) {
+    dependencies.userSessionScope.cancel()
+    dependencies.userScopedCloseables.forEach { it.close() }
   }
 }
